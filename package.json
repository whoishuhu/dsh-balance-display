{
  "name": "@local/dsh-balance-display",
  "version": "1.0.0",
  "description": "Display account balance in the bottom-right corner of DeepSeek Harness",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "keywords": [
    "deepseek-harness",
    "balance",
    "account",
    "ui"
  ],
  "author": "beena",
  "license": "MIT"
}
